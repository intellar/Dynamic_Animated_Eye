# Normalize line endings: keep LF in the repo and on checkout (Linux target = Pi).
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.ino text eol=lf
*.txt text eol=lf
*.service text eol=lf
# Les hooks sont executes par `sh` : un CR dans le fichier casse l'execution.
scripts/hooks/* text eol=lf
