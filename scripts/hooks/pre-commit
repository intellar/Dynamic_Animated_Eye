#!/bin/sh
# Garde-fou : refuse un commit qui introduit un secret ou un fichier qui n'a
# rien a faire dans le depot.
#
#   git config core.hooksPath scripts/hooks     # active (une fois par clone)
#   git commit --no-verify                      # passe outre, volontairement
#
# Ce qui est inspecte : les fichiers **indexes** seulement (pas tout le disque).
#   1. le nom du fichier (`.env`, cle privee, certificat, `known_hosts`, ...)
#   2. son contenu, s'il s'agit d'un fichier texte : cle privee, jeton GitHub ou
#      cloud, URL contenant des identifiants en clair, affectation d'un mot de
#      passe ou d'une cle d'API, ...
#   3. avertissement (non bloquant) sur une adresse du reseau local
#
# Les motifs sont assembles a l'execution (`-----` + `BEGIN ...`) pour que ce
# fichier, une fois modifie et indexe, ne se detecte pas lui-meme.

set -u

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

staged=$(git diff --cached --name-only --diff-filter=ACM) || exit 1
[ -z "$staged" ] && exit 0

hits="$root/.git/pre-commit-hits.$$"
: > "$hits"
trap 'rm -f "$hits"' EXIT INT TERM

text_re='\.(py|json|md|txt|sh|ps1|psm1|service|ya?ml|ino|cfg|toml|bat|cmd|gitignore|gitattributes)$'

# --- 1. noms de fichiers ----------------------------------------------------
for f in $staged; do
    case "$f" in
        *.pem|*.key|*.pfx|*.p12|*.jks|*.kdbx|*.ovpn|id_rsa*|id_ed25519*|known_hosts*|authorized_keys|.env|.env.*|.netrc|.pgpass|.npmrc|.pypirc|*credential*|*secret*|*password*)
            echo "pre-commit: nom de fichier interdit : $f" >&2
            echo name >> "$hits"
            ;;
    esac
done

# --- 2. contenu des fichiers texte ------------------------------------------
dashes='-----'
key_pat="$dashes"'BEGIN [A-Z ]*PRIVATE KEY'"$dashes"
gh_pat="gh"'[pousr]_[A-Za-z0-9]{20,}'
gh_fine="github"'"_pat_[A-Za-z0-9_]{20,}'
aws_pat="AKIA"'[0-9A-Z]{16}'
sk_pat="sk"'-[A-Za-z0-9]{20,}'
url_pat="[a-zA-Z][a-zA-Z0-9+.-]*://[^ /:@]+:[^ /@]+@"
val_pat="(password|passwd|passphrase|api[_-]?key|access[_-]?key|private[_-]?key|secret|token)[[:space:]]*[:=][[:space:]]*[\"']?[A-Za-z0-9/+=_.:@-]{4,}"
local_ip_pat='(^|[^0-9])(10\.[0-9]{1,3}|192\.168|172\.(1[6-9]|2[0-9]|3[01]))\.[0-9]{1,3}\.[0-9]{1,3}([^0-9]|$)'

for f in $staged; do
    case "$f" in
        scripts/hooks/*) continue ;;
    esac
    printf '%s\n' "$f" | grep -Eqi "$text_re" || continue

    git show ":$f" 2>/dev/null \
        | grep -Eni -e "$key_pat|$gh_pat|$gh_fine|$aws_pat|$sk_pat|$url_pat|$val_pat" \
        | while IFS= read -r hit; do
            echo "pre-commit: secret probable : $f:$hit" >&2
            echo content >> "$hits"
        done

    git show ":$f" 2>/dev/null \
        | grep -En -e "$local_ip_pat" \
        | while IFS= read -r hit; do
            echo "pre-commit: avertissement, adresse du reseau local : $f:$hit" >&2
            echo warn >> "$hits"
        done
done

# --- verdict ----------------------------------------------------------------
if grep -Eq '^(name|content)$' "$hits"; then
    echo "" >&2
    echo "pre-commit: commit refuse. Retirer le secret, ou forcer : git commit --no-verify" >&2
    rm -f "$hits"
    exit 1
fi
if grep -q '^warn$' "$hits"; then
    echo "pre-commit: avertissement seulement, le commit passe." >&2
fi
rm -f "$hits"
exit 0
